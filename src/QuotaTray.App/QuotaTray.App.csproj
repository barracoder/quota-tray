<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>QuotaTray</AssemblyName>
    <RootNamespace>QuotaTray.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/quota-tray.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Description>Menu bar / system tray gauge for remaining AI quota.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../QuotaTray.Core/QuotaTray.Core.csproj" />
    <ProjectReference Include="../QuotaTray.Providers.Anthropic/QuotaTray.Providers.Anthropic.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="macos/Info.plist" />
    <None Include="assets/**" />
  </ItemGroup>
</Project>
